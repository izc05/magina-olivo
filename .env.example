NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_URL=postgres://magina:magina_local@localhost:5432/magina_olivo
DB_POOL_MAX=10
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173
# Production/staging MUST provide a strong secret. Generate one with: npx auth@latest secret
BETTER_AUTH_SECRET=

# Commercial visibility is intentionally OFF during the staging/MiniPC pilot.
# Enable only in an explicit post-staging environment once sponsorship data has been reviewed.
MAGINA_ADVERTISING_ENABLED=false

# AEMET OpenData stays server-side. Never expose this key in VITE_* variables or browser code.
# Enabled municipalities are the verified rows in public_municipalities, not a browser/user-supplied code allowlist.
AEMET_API_KEY=

# Optional override for the official RAIF olivar ZIP resource.
# The worker rejects non-HTTPS and non-Junta de Andalucía hosts.
RAIF_OLIVAR_ZIP_URL=

# Optional overrides for the Observatorio structured market resources.
# The worker rejects non-HTTPS and non-Junta de Andalucía hosts.
MARKET_WEEKLY_CSV_URL=
MARKET_WEEKLY_JSON_URL=

# Durable worker defaults. Lease must exceed the normal duration of a job.
WORKER_POLL_MS=5000
WORKER_RETRY_SECONDS=5
WORKER_LEASE_SECONDS=120
# Automatic AEMET rain-alarm scan cadence. Valid range: 5..1440 minutes.
RAIN_ALERT_SCAN_MINUTES=30
# Animated AEMET radar capture cadence. Valid range: 5..60 minutes.
WEATHER_RADAR_CAPTURE_MINUTES=10
