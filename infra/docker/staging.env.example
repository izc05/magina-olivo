# Copy to a secrets-managed environment file outside Git.
# Never commit real values.

POSTGRES_PASSWORD=replace-with-long-url-safe-secret
DATABASE_URL=postgres://magina:replace-with-long-url-safe-secret@postgres:5432/magina_olivo

# Raspberry / external disk mode.
# Leave MAGINA_POSTGRES_DATA_DIR unset to use the default Docker named volume.
# On Raspberry, set it to a directory on the mounted SSD/USB disk and set
# STAGING_REQUIRE_EXTERNAL_DATA=1 so preflight rejects accidental microSD/root storage.
# Example: /srv/magina-olivo/postgres
MAGINA_POSTGRES_DATA_DIR=
STAGING_REQUIRE_EXTERNAL_DATA=0

BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=https://magina-staging.example.com
BETTER_AUTH_TRUSTED_ORIGINS=https://magina-staging.example.com

# AEMET OpenData. Server-side only; never expose this key in the web bundle.
AEMET_API_KEY=replace-with-aemet-opendata-api-key

# Transactional password-reset email for external staging/pilot.
# Keep disabled until the sending domain is verified with the provider.
AUTH_MAIL_TRANSPORT=resend
AUTH_MAIL_FROM="Mágina Olivo <no-reply@staging.example.com>"
RESEND_API_KEY=replace-with-resend-api-key

# Cloudflare R2 / S3-compatible object storage.
PRIVATE_STORAGE_DRIVER=s3
OBJECT_STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
OBJECT_STORAGE_BUCKET=magina-olivo-staging-private
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=replace-me
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-me
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Bind only to loopback. Point Cloudflare Tunnel at http://127.0.0.1:8088.
STAGING_BIND=127.0.0.1:8088

LOG_LEVEL=info
DB_POOL_MAX=10
WORKER_POLL_MS=5000
WORKER_RETRY_SECONDS=5
WORKER_LEASE_SECONDS=120
# Animated radar capture cadence. Allowed range: 5-60 minutes.
WEATHER_RADAR_CAPTURE_MINUTES=10
# Structured portability artifacts expire automatically. Allowed range: 1-168 hours.
ACCOUNT_EXPORT_TTL_HOURS=24
