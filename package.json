{
  "name": "magina-olivo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @magina/web",
    "dev:api": "npm run dev --workspace @magina/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run auth:migrate --workspace @magina/api && npm run db:migrate --workspace @magina/api"
  },
  "devDependencies": {
    "typescript": "^6.0.0"
  }
}
