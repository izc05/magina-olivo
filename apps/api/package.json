{
  "name": "@magina/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/server.ts",
    "start": "node --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "db:migrate": "node --env-file-if-exists=../../.env scripts/migrate.ts",
    "auth:generate": "npx auth@1.7.2 generate --config src/auth.ts --output ../../db/auth-schema.sql --yes",
    "auth:migrate": "npx auth@1.7.2 migrate --config src/auth.ts --yes"
  },
  "dependencies": {
    "better-auth": "^1.7.2",
    "fastify": "^5.12.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1"
  }
}
